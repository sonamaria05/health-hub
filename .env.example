# Frontend environment variables (Vite). Copy this file to `.env` and fill
# in real values. Everything prefixed VITE_ is bundled into the client-side
# JavaScript and is therefore PUBLIC - never put a secret key here.

# Your Supabase project URL, e.g. https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key (safe for the browser - access is governed
# by Row Level Security, not by keeping this key secret).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: enables mock/demo data paths in the UI for local development
# without a seeded database. Leave unset ("false") in any deployed
# environment.
VITE_ENABLE_DEMO_DATA=false

# -----------------------------------------------------------------------
# Edge function secrets (Supabase project secrets, NOT part of this file):
#   supabase secrets set LOVABLE_API_KEY=...
#   supabase secrets set PHI_ENCRYPTION_KEY=...
#   supabase secrets set ALLOWED_ORIGIN=https://your-deployed-app.example.com
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically into edge functions by the Supabase platform and
# do not need to be set manually.
# See SECURITY.md and PROJECT_REPORT.md for the full list and how to
# generate each one.
# -----------------------------------------------------------------------
